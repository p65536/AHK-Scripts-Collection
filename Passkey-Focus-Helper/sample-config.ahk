; ==============================================================================
;  User Configuration for Passkey Focus Helper
; ==============================================================================

; ------------------------------------------------------------------------------
;  Tray Icon & Tooltip Settings
; ------------------------------------------------------------------------------
; Icon source:
;   "path\icon.ico"       : External icon file
;   "path\resource,index" : Icon resource using a zero-based index
; ------------------------------------------------------------------------------

; Icon file:
; trayIconSpec := "C:\Path\To\icon.ico"

; DLL icon resource (zero-based index):
; trayIconSpec := A_WinDir . "\System32\imageres.dll,54"

; Tray tooltip:
; trayIconTip  := "[AHK] Passkey Focus Helper"
